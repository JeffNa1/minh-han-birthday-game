[node name="GuideContent" type="Label" parent="GuidePanel/Box"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/line_spacing = 6
theme_override_font_sizes/font_size = 15
text = "♥  Rê chuột để Minh Hân đi khắp sân trường, hành lang và sân thượng.
♥  Giữ chuột lên một Nam Anh để phóng tia tình yêu. Chàng đi đâu thì rê theo đó!
♥  Mỗi chàng đổ +1 tim. Đầy 10 tim trước khi hết giờ để qua màn; tim tự hao dần.
♥  Đối thủ cướp chàng của bạn: bấm chuột thật nhanh để giành lại.
♥  Cô quản lý mà thấy là đuổi theo. Bị bắt mất tim và mất chàng!
♥  Qua màn được mở hộp quà: xu, kim cương, tóc, tia và trang phục hiếm."
autowrap_mode = 2

