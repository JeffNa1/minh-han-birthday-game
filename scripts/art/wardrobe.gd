static func ids_for(character: String) -> Array:
	var out: Array = []
	for id: String in OUTFITS:
		if OUTFITS[id]["owner"] == character:
			out.append(id)
	return out

static func default_for(character: String) -> String:
	return "pajamas" if character == "minh_han" else ("ocean" if character == "nam_anh" else character)

## Two representative colors, used by the wardrobe buttons.
static func swatch(id: String) -> Array:
	var fit: Dictionary = OUTFITS[id]
	var upper: Color = fit["outer"]["color"] if fit.has("outer") else fit["top"]["color"]
	var lower: Color = fit["bottom"]["color"] if fit["bottom"]["type"] != "none" else fit["top"]["color"]
	return [upper, lower]
